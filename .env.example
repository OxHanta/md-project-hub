# Add your Google Gemini API Key here and rename this file to .env
# IMPORTANT: never commit a real key. Generate one at https://aistudio.google.com/apikey
# and keep it only in your local .env file (which is gitignored).
GEMINI_API_KEY=your_gemini_api_key_here
PORT=3000
# Optional: comma-separated list of origins allowed to call the API (CORS).
# Leave empty to only allow same-origin requests.
ALLOWED_ORIGINS=
